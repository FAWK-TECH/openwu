<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\openwu.ico</ApplicationIcon>
    <AssemblyName>OpenWU</AssemblyName>
    <RootNamespace>OpenWu.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenWu.Core\OpenWu.Core.csproj" />
    <ProjectReference Include="..\OpenWu.CliLib\OpenWu.CliLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\openwu-mark.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
